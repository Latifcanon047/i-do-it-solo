generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MindMap {
  id        String   @id @default(cuid())
  title     String
  content   Json     @default("{}")
  canvasTheme String   @default("dark") 
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  collaborators MindMapCollaborator[]
  pendingInvites PendingInvite[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?
  googleId      String?   @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mindMaps      MindMap[]
  collaboratingOn MindMapCollaborator[]
}

model PendingRegistration {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum CollaboratorRole {
  EDITOR
  VIEWER
}

model MindMapCollaborator {
  id        String           @id @default(cuid())
  mindMapId String
  mindMap   MindMap          @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CollaboratorRole
  invitedAt DateTime         @default(now())

  @@unique([mindMapId, userId])
}

model PendingInvite {
  id        String           @id @default(cuid())
  mindMapId String
  mindMap   MindMap          @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  email     String
  role      CollaboratorRole
  token     String           @unique @default(cuid())
  invitedAt DateTime         @default(now())
  expiresAt DateTime

  @@unique([mindMapId, email])
}